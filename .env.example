# ========================================================
# CineVerse AI - Backend Environment Configuration Example
# ========================================================

# Server Configuration
# Local development uses 5000; Render assigns PORT automatically in production
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Allowed Frontend Origins for CORS
# Comma-separated list of allowed URLs (e.g. local Vite dev and deployed Vercel frontend)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/cineverse_ai
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/cineverse_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cineverse_ai

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Seat Lock Duration (in minutes)
SEAT_LOCK_TIMEOUT_MINUTES=5

# Admin Bootstrap Credentials
ADMIN_NAME=CineVerse SuperAdmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_PHONE=9876543210

# Theatre Demo Credentials
THEATRE_NAME=Express Avenue Theatre Manager
THEATRE_EMAIL=theatre@example.com
THEATRE_PASSWORD=your_theatre_password_here
THEATRE_PHONE=9876543212

# Customer Demo Credentials
CUSTOMER_NAME=Demo Moviegoer
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=your_customer_password_here
CUSTOMER_PHONE=9876543211

# Optional API Integrations
TMDB_API_KEY=
GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
YOUTUBE_API_KEY=
